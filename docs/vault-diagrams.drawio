e PIN 6-12 digits (weak PINs refused),&#10;confirm" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="80" as="geometry"/></mxCell><mxCell id="c71" value="KeyHierarchy.setUp:&#10;new entropy -&gt; master key,&#10;wrap under PIN + Keystore,&#10;store pin_len" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="260" height="90" as="geometry"/></mxCell><mxCell id="c72" value="Recovery phrase screen&#10;(24 words shown ONCE, never stored)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="70" as="geometry"/></mxCell><mxCell id="c73" value="MAIN: unlocked&#10;sessionKey in RAM, library visible" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="260" height="70" as="geometry"/></mxCell><mxCell id="c74" value="forceLock():&#10;sessionKey = null, thumbnails evicted,&#10;share/play temp files swept" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="260" height="90" as="geometry"/></mxCell><mxCell id="c75" value="Lock triggers:&#10;- app to background (onStop, autolock 0 s)&#10;- auto-lock timeout 30 s / 1 min / 5 min&#10;- Lock now menu&#10;- split-screen / multi-window&#10;- duress wipe" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="300" height="120" as="geometry"/></mxCell><mxCell id="c76" value="Lock screen: PIN pad&#10;(dots = stored pin_len)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="240" height="70" as="geometry"/></mxCell><mxCell id="c77" value="digits entered&#10;== pin_len ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="240" height="100" as="geometry"/></mxCell><mxCell id="c78" value="KeyHierarchy&#10;.unlockWithPin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="240" height="100" as="geometry"/></mxCell><mxCell id="c79" value="isDuressPin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="710" width="240" height="90" as="geometry"/></mxCell><mxCell id="c80" value="finish(): resetFailures,&#10;sessionKey = master key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="560" width="240" height="70" as="geometry"/></mxCell><mxCell id="c81" value="PanicWipe.execute:&#10;1 crypto-erase keys (Keystore + prefs)&#10;2 cancel WorkManager&#10;3 delete DB, files/vault, cache&#10;4 setUp(new vault, entered PIN)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="300" height="130" as="geometry"/></mxCell><mxCell id="c82" value="recordFailure():&#10;after 5 tries lockout 30 s, doubling to 15 min&#10;(persisted across restarts)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="860" width="300" height="80" as="geometry"/></mxCell><mxCell id="c83" value="Forgot PIN? Recovery phrase:&#10;phrase -&gt; same master key,&#10;choose new PIN (re-wrap)" style="rounde