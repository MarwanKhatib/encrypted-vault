ext;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="34" as="geometry"/></mxCell><mxCell id="c157" value="Recovery phrase&#10;24 BIP-39 words (256-bit entropy)&#10;shown once on paper" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="80" as="geometry"/></mxCell><mxCell id="c158" value="HKDF-SHA256&#10;'vault-master-v1'" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="260" height="60" as="geometry"/></mxCell><mxCell id="c159" value="MASTER KEY (AES-256)&#10;never stored in the clear" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="70" as="geometry"/></mxCell><mxCell id="c160" value="PIN (6-12 digits)&#10;+ random 16 B salt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="240" height="70" as="geometry"/></mxCell><mxCell id="c161" value="PBKDF2-HMAC-SHA256&#10;600,000 iterations -&gt; 256-bit key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="210" width="240" height="70" as="geometry"/></mxCell><mxCell id="c162" value="Inner wrap: AES-GCM(master)&#10;under PIN-derived key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="240" height="70" as="geometry"/></mxCell><mxCell id="c163" value="Outer wrap: AES-GCM(inner)&#10;under Keystore key vault_wrap_key&#10;(device-bound, StrongBox/TEE)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="280" height="90" as="geometry"/></mxCell><mxCell id="c164" value="wrapped_pin in vault_keys prefs&#10;(useless off this device)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="c165" value="Biometric key vault_bio_key&#10;(strong biometric each use)&#10;-&gt; wrapped_bio" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="260" height="80" as="geometry"/></mxCell><mxCell id="c166" value="Content subkey&#10;HMAC-SHA256(master, 'vault-stream-v2')&#10;-&gt; Tink AES-GCM-HKDF streams" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="80" as="geometry"/></mxCell><mxCell id="c167" value="metaEnc, album names:&#10;AES-GCM directly with master" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="280" height="60" as="geometry"/></mxCell><mxCell id="c168" value="Files &lt;hash&gt;.enc / .thumb.enc&#10;AEAD per 1 MiB segment,&#10;AAD = file name" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="280" height="80" as="geometry"/></mxCell><mxCell id="c169" value="Duress PIN: PBKDF2 verifier only&#10;(salt + hash), same length as PIN;&#10;NOT a key, cannot decrypt anything" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="300" height="80" as="geometry"/></mxCell><mxCell id="c170" value="Crypto-erase: delete wrappers + Keystore keys&#10;=&gt; all ciphertext permanently unreadable;&#10;then delete DB / files / cache" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="320" height="90" as="geometry"/></mxCell><mxCell id="c171" value="Unlock path: PIN -&gt; PBKDF2 -&gt; Keystore decrypt&#10;-&gt; PIN-key decrypt -&gt; master key in RAM&#10;(or biometric unwrap, or phrase re-derive)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="340" height="90" as="geometry"/></mxCell><mxCell id="c172" value="Legacy v1 vault: wrapped_pin = AES-GCM under PIN key only (310k iterations) plus an unused unauthenticated&#10;Keystore wrap. First successful unlock upgrades to the layout above and deletes the unused wrap." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="760" y="600" width="380" height="100" as="geometry"/></mxCell><mxCell id="c173" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="c157" target="c158"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c174" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="c158" target="c159"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c175" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="c160" target="c161"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c176" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;" edge="1" parent="1" source="c161" target="c162"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c177" value="master enco