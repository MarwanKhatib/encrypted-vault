ht="70" as="geometry"/></mxCell><mxCell id="c109" value="size &lt;= 500 MiB ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="90" as="geometry"/></mxCell><mxCell id="c110" value="Skipped, snackbar:&#10;'larger than 500 MB'" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="295" width="220" height="60" as="geometry"/></mxCell><mxCell id="c111" value="MediaTransfer.stage:&#10;copy to cache/import (plaintext, temporary)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="240" height="70" as="geometry"/></mxCell><mxCell id="c112" value="ImportWorker (WorkManager,&#10;resumable, idempotent)&#10;SHA-256 of plaintext" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="80" as="geometry"/></mxCell><mxCell id="c113" value="hash already&#10;'complete'?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="240" height="100" as="geometry"/></mxCell><mxCell id="c114" value="Duplicate: delete staged copy,&#10;skip" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="220" height="60" as="geometry"/></mxCell><mxCell id="c115" value="insert row status='pending'" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="240" height="50" as="geometry"/></mxCell><mxCell id="c116" value="VaultFiles.encryptAtomic&#10;magic + Tink 1 MiB segments&#10;.tmp -&gt; fs