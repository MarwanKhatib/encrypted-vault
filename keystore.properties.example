# Copy to keystore.properties (git-ignored) and fill in. Keep the keystore file itself outside the repo.
# Create one once with:
#   keytool -genkeypair -v -keystore ~/keys/vault-release.jks -alias vault -keyalg RSA -keysize 4096 -validity 10000
storeFile=/home/you/keys/vault-release.jks
storePassword=CHANGE_ME
keyAlias=vault
keyPassword=CHANGE_ME
