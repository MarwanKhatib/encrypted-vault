<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Deliberately NO INTERNET permission: the app is offline by design. Third-party libraries must not
         add it back; the line below strips it from the merged manifest if one ever tries. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- SECURITY-CRITICAL (Gap 1): allowBackup=false keeps the vault out of Google cloud / adb backup.
         Do NOT "clean up". Verify: adb backup -f test.ab com.example.encryptedvault -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_vault"
        android:roundIcon="@mipmap/ic_launcher_vault"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault"
        android:name=".VaultApp">
        <!-- Gap 2: no directBootAware anywhere; data stays in credential-encrypted storage. -->

        <!-- The real screen. It has no launcher entry itself: one of the aliases below provides it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:supportsPictureInPicture="false" />

        <!-- Launcher icons. Exactly one alias is enabled at a time (see appicon/AppIcon.kt). VaultAlias is the default. -->
        <activity-alias
            android:name=".alias.VaultAlias" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_vault" android:roundIcon="@mipmap/ic_launcher_vault" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.WeatherAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_weather" android:roundIcon="@mipmap/ic_launcher_weather" android:label="@string/disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.CalculatorAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator" android:roundIcon="@mipmap/ic_launcher_calculator" android:label="@string/disguise_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.NotesAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_notes" android:roundIcon="@mipmap/ic_launcher_notes" android:label="@string/disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.ClockAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_clock" android:roundIcon="@mipmap/ic_launcher_clock" android:label="@string/disguise_clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Temporary decrypted copies for sharing; cache/share is wiped on lock and on the next start. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
