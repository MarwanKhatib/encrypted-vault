<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only requested when the user turns on auto-import (ADR-013). Without it the app sees no gallery items. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- INTERNET is used only to check GitHub for a newer release and download it (ADR-015). Nothing else talks to the network;
         libraries must not add other network use. Photos and keys never leave the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installing a downloaded update (Android asks the user once per source, then confirms each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Notification when a newer release exists (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SECURITY-CRITICAL (Gap 1): allowBackup=false keeps the vault out of Google cloud / adb backup.
         Do NOT "clean up". Verify: adb backup -f test.ab com.example.encryptedvault -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_vault"
        android:roundIcon="@mipmap/ic_launcher_vault"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vault"
        android:name=".VaultApp">
        <!-- Gap 2: no directBootAware anywhere; data stays in credential-encrypted storage. -->

        <!-- The real screen. It has no launcher entry itself: one of the aliases below provides it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:supportsPictureInPicture="false" />

        <!-- Launcher icons. Exactly one alias is enabled at a time (see appicon/AppIcon.kt). VaultAlias is the default. -->
        <activity-alias
            android:name=".alias.VaultAlias" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
            android:icon="@mipmap/ic_launcher_vault" android:roundIcon="@mipmap/ic_launcher_vault" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.WeatherAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_weather" android:roundIcon="@mipmap/ic_launcher_weather" android:label="@string/disguise_weather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.CalculatorAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator" android:roundIcon="@mipmap/ic_launcher_calculator" android:label="@string/disguise_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.NotesAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_notes" android:roundIcon="@mipmap/ic_launcher_notes" android:label="@string/disguise_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.ClockAlias" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_launcher_clock" android:roundIcon="@mipmap/ic_launcher_clock" android:label="@string/disguise_clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Gets the result of the update install (success, failure, or the system confirm prompt). Not exported. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Temporary decrypted copies for sharing; cache/share is wiped on lock and on the next start. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
